# nextpanel.env — EnvironmentFile for the systemd unit. Copy to
# /etc/nextpanel/nextpanel.env, set the values, and chmod 600 it.
# Generate the key with: nextpanel crypto generate-key

NEXT_PANEL_ENV=production
NEXT_PANEL_EXTERNAL_SCHEME=https
NEXT_PANEL_LISTEN=127.0.0.1:8080
NEXT_PANEL_DATA_DIR=/var/lib/nextpanel
# REQUIRED. Paste the output of: nextpanel crypto generate-key
NEXT_PANEL_ENCRYPTION_KEY=
# NEXT_PANEL_DB_DRIVER=postgres
# NEXT_PANEL_DB_DSN=postgres://nextpanel:SECRET@127.0.0.1:5432/nextpanel?sslmode=require
# NEXT_PANEL_BOOTSTRAP_ADMIN=true
# NEXT_PANEL_METRIC_INTERVAL=60s
