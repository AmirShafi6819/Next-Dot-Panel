# Binaries and build output
/next-panel
/nextpanel
*.exe
*.test
*.out

# Local configuration — never commit real secrets
.env
.env.*
!.env.example

# Runtime data
/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Test and tooling output
coverage.out
coverage.html
*.prof

# Frontend build output and dependencies (the built UI is produced by
# `npm run build` in web/; only the placeholder is committed)
web/dist/*
!web/dist/.gitkeep
web/node_modules/

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
