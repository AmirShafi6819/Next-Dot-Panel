# Next.Panel configuration — copy to .env and edit.
#
# This file contains NO real secrets. Every value below is a placeholder.
# Never commit a populated .env file.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# "development" or "production".
# Production refuses to start with NEXT_PANEL_EXTERNAL_SCHEME=http, because
# cookies would lose their Secure flag.
NEXT_PANEL_ENV=development

# Address the HTTP server binds to.
NEXT_PANEL_LISTEN=:8080

# Public base URL. Used for the default allowed origin and for links.
NEXT_PANEL_BASE_URL=http://localhost:8080

# Scheme the browser actually uses. Set to https when behind a TLS proxy.
NEXT_PANEL_EXTERNAL_SCHEME=http

NEXT_PANEL_TIMEZONE=UTC

# Directory for the SQLite database, backups, and runtime state.
NEXT_PANEL_DATA_DIR=./data

# DEBUG, INFO, WARN, ERROR
NEXT_PANEL_LOG_LEVEL=INFO

# "text" for development, "json" for production log aggregation.
NEXT_PANEL_LOG_FORMAT=text

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# "sqlite" or "postgres".
NEXT_PANEL_DB_DRIVER=sqlite

# For SQLite: leave blank to use <DATA_DIR>/nextpanel.db.
# For PostgreSQL: a full DSN is required, e.g.
#   postgres://nextpanel:CHANGE_ME@localhost:5432/nextpanel?sslmode=disable
NEXT_PANEL_DB_DSN=

# Connection pool size. Ignored for SQLite, which is pinned to a single writer.
NEXT_PANEL_DB_MAX_CONNS=10

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# REQUIRED. Generate with:  nextpanel crypto generate-key
# This key encrypts stored SSH credentials. The database holds only ciphertext.
#
# BACK IT UP SEPARATELY FROM THE DATABASE. A database backup without this key
# cannot decrypt any stored credential, and storing the key beside the backup
# removes the protection it provides.
NEXT_PANEL_ENCRYPTION_KEY=

# Identifies which key encrypted each blob, so keys can be rotated without
# re-encrypting everything at once.
NEXT_PANEL_ENCRYPTION_KEY_ID=1

# Previous keys still needed to decrypt existing credentials, as
# "id:base64key,id:base64key". Remove an entry once the rotation sweep has
# re-encrypted everything that used it.
NEXT_PANEL_ENCRYPTION_PREVIOUS_KEYS=

# Session lifetime and idle timeout. Idle must not exceed lifetime.
NEXT_PANEL_SESSION_LIFETIME=12h
NEXT_PANEL_SESSION_IDLE=2h

# How long a fresh password confirmation is valid for sensitive operations
# (changing a password, managing host keys, creating tokens, enabling
# privileged subsystems).
NEXT_PANEL_REAUTH_WINDOW=5m

# Trusted reverse proxies. Forwarded headers are honoured ONLY when the
# immediate peer matches one of these. Comma-separated IPs or CIDRs.
# Leave empty if Next.Panel is exposed directly.
NEXT_PANEL_TRUSTED_PROXIES=

# Origins allowed for realtime connections. Defaults to the BASE_URL origin.
# Comma-separated, e.g. https://panel.example.com
NEXT_PANEL_ALLOWED_ORIGINS=

# Authentication rate limiting and progressive lockout.
NEXT_PANEL_RATE_LIMIT_AUTH=10
NEXT_PANEL_RATE_LIMIT_AUTH_WINDOW=15m
NEXT_PANEL_MAX_LOGIN_FAILURES=5
NEXT_PANEL_LOGIN_LOCKOUT_WINDOW=15m

# ---------------------------------------------------------------------------
# Bootstrap administrator
# ---------------------------------------------------------------------------

# On first start, when the users table is empty, Next.Panel creates an
# administrator and flags it as using default credentials. The login page and
# the dashboard then show a warning until the password is changed.
#
# Set to false to skip seeding entirely; a setup wizard then creates the first
# administrator interactively. Recommended for packaged distributions that must
# not ship default credentials.
NEXT_PANEL_BOOTSTRAP_ADMIN=true
NEXT_PANEL_BOOTSTRAP_USERNAME=admin
NEXT_PANEL_BOOTSTRAP_PASSWORD=123456

# ---------------------------------------------------------------------------
# Privileged subsystems — all DISABLED by default
# ---------------------------------------------------------------------------
#
# Each of these is equivalent to host-level privilege when enabled. Enable them
# only where you understand and accept that. See SECURITY.md.

# Manage the host Next.Panel itself runs on.
NEXT_PANEL_LOCAL_EXECUTION_ENABLED=false

# Roots the local file manager may access. Empty means unrestricted when local
# execution is enabled. Comma-separated absolute paths.
NEXT_PANEL_LOCAL_FILE_ROOTS=

# Docker/Podman management. Socket access is effectively root on the host.
NEXT_PANEL_CONTAINERS_ENABLED=false

# systemd service management.
NEXT_PANEL_SERVICES_ENABLED=false

# ---------------------------------------------------------------------------
# Resource limits
# ---------------------------------------------------------------------------

NEXT_PANEL_MAX_UPLOAD_BYTES=2147483648
NEXT_PANEL_MAX_CONCURRENT_UPLOADS=3
NEXT_PANEL_MAX_TERMINALS_PER_USER=5
NEXT_PANEL_MAX_TERMINALS_PER_SERVER=10
NEXT_PANEL_MAX_TERMINALS_GLOBAL=200
NEXT_PANEL_MAX_CONN_PER_SERVER=4
NEXT_PANEL_MAX_CONN_PER_USER=8
NEXT_PANEL_MAX_FILE_LIST_ENTRIES=5000
NEXT_PANEL_MAX_PREVIEW_BYTES=1048576
NEXT_PANEL_MAX_ARCHIVE_ENTRIES=100000
NEXT_PANEL_MAX_ARCHIVE_TOTAL_BYTES=4294967296
NEXT_PANEL_MAX_ARCHIVE_FILE_BYTES=1073741824
NEXT_PANEL_MAX_ARCHIVE_RATIO=100
NEXT_PANEL_MAX_COMMAND_OUTPUT_BYTES=1048576
NEXT_PANEL_METRICS_POINT_BUDGET=1500

# ---------------------------------------------------------------------------
# Timeouts — every network operation is bounded
# ---------------------------------------------------------------------------

NEXT_PANEL_SSH_CONNECT_TIMEOUT=10s
NEXT_PANEL_SSH_AUTH_TIMEOUT=15s
NEXT_PANEL_COMMAND_TIMEOUT=30s
NEXT_PANEL_DB_QUERY_TIMEOUT=15s
NEXT_PANEL_HTTP_TIMEOUT=60s
NEXT_PANEL_FILE_IDLE_TIMEOUT=30m
NEXT_PANEL_TERMINAL_IDLE_TIMEOUT=30m
NEXT_PANEL_SSH_KEEPALIVE=30s
NEXT_PANEL_SSH_IDLE_TIMEOUT=5m
NEXT_PANEL_SSH_MAX_RECONNECTS=5

# ---------------------------------------------------------------------------
# Metrics and retention
# ---------------------------------------------------------------------------

# Collection interval. Minimum 1s; a shorter interval saturates the SSH
# connection for no benefit.
NEXT_PANEL_METRIC_INTERVAL=5s

NEXT_PANEL_METRIC_RETENTION_RAW=24h
NEXT_PANEL_METRIC_RETENTION_5M=720h
NEXT_PANEL_METRIC_RETENTION_1H=8760h
NEXT_PANEL_AUDIT_RETENTION=8760h
NEXT_PANEL_LOGIN_HISTORY_RETENTION=4320h
NEXT_PANEL_APP_LOG_RETENTION=720h

# ---------------------------------------------------------------------------
# Background work
# ---------------------------------------------------------------------------

NEXT_PANEL_SCHEDULER_ENABLED=true
NEXT_PANEL_WORKERS_ENABLED=true
NEXT_PANEL_WORKER_COUNT=4

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------

# Where database backups are written. Defaults to <DATA_DIR>/backups.
NEXT_PANEL_BACKUP_DIR=
NEXT_PANEL_BACKUP_RETENTION=7
